# RandRoute frontend — copy to .env if you need to change it.
# The frontend holds NO Supabase or Gemini keys. It only talks to the backend.

# Leave empty in development: Vite forwards /api to http://localhost:4000.
# In production, set this to the deployed backend URL, e.g. https://api.randroute.app
VITE_API_BASE_URL=
