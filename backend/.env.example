# RandRoute backend — copy to .env and fill in.  NEVER commit .env.
# Find the Supabase values in: Supabase Dashboard → Project Settings → API (API Keys).

PORT=4000
NODE_ENV=development

# Where the frontend runs. Comma-separate several origins if needed.
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# "anon" / "publishable" key. Used for auth calls and user-scoped queries (RLS applies).
SUPABASE_ANON_KEY=
# "service_role" / "secret" key. Bypasses RLS. Server only — admin tasks like account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Where Supabase emails (verify / reset password) should send people back to.
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# --- Gemini (optional AI) ---------------------------------------------------
# Leave AI_ENABLED=false until you have reviewed Gemini's data-handling terms.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
