# RandRoute backend settings. Copy to backend/.env for local development.
# On Vercel, add the same names in Project → Settings → Environment Variables (Production).
# NEVER commit real values.

# --- Required ---------------------------------------------------------------
# Supabase → Project Settings → API
SUPABASE_URL=
# Publishable / anon key (SUPABASE_ANON_KEY also works)
SUPABASE_PUBLISHABLE_KEY=
# Secret / service_role key — server only (SUPABASE_SERVICE_ROLE_KEY also works)
SUPABASE_SECRET_KEY=

# --- Site address -----------------------------------------------------------
# Where the frontend lives. Used for email links (verify / reset password) and allowed origins.
# Local: http://localhost:4173   Live: https://randroute-two.vercel.app
# On Vercel you can leave this empty: the project's production address is used automatically.
FRONTEND_URL=http://localhost:4173

# --- Optional ---------------------------------------------------------------
# Local only — Vercel ignores PORT and sets NODE_ENV=production itself. Empty is fine.
PORT=4000
NODE_ENV=

# AI explanations (Gemini). Leave AI_ENABLED=false to switch AI off.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Backup model, tried if the main one is busy or unavailable. Leave empty for none.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Streams its thinking on the Explain my spending page.
GEMINI_THINKING_MODEL=gemini-3.5-flash

# Advanced (rarely needed): set these instead of FRONTEND_URL to control them separately.
# FRONTEND_ORIGIN=https://randroute-two.vercel.app
# AUTH_REDIRECT_URL=https://randroute-two.vercel.app/auth/callback
